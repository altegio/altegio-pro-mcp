# Altegio API Configuration

# Partner API Token (required)
# Get this from https://developer.alteg.io → Account settings → Account details
ALTEGIO_API_TOKEN=your_partner_token_here

# User Token (optional - use auth_login tool instead)
# User token is automatically saved to ~/.altegio-mcp/credentials.json after login
# ALTEGIO_USER_TOKEN=your_user_token_here

# API Base URL (optional)
ALTEGIO_API_BASE=https://api.alteg.io/api/v1

# Server Configuration (optional)
# MCP_SERVER_NAME=@altegio/mcp-server-pro
# MCP_SERVER_DESCRIPTION="MCP server for Altegio API"

# Environment (optional)
NODE_ENV=development

# HTTP defaults to loopback locally; signing keys or REQUIRE_DELEGATED_IDENTITY
# select hosted mode automatically. Set the mode explicitly when deploying.
# MCP_HTTP_MODE=local
# MCP_HTTP_HOST=127.0.0.1
# Additional backend Host names (no ports) and exact browser Origins:
# MCP_HTTP_ALLOWED_HOSTS=backend.example.com
# MCP_HTTP_ALLOWED_ORIGINS=https://client.example.com
# Local-only legacy opt-in; hosted mode never borrows a shared user credential.
# MCP_HTTP_ALLOW_SHARED_CREDENTIALS=false
ALTEGIO_REQUEST_TIMEOUT_MS=30000
MCP_SHUTDOWN_TIMEOUT_MS=30000

# HTTP retention (optional): tune against the container heap budget.
# Shared across all views; a full budget evicts the least recently used idle
# session. Idle expiry after a tool call, and before one.
MCP_HTTP_MAX_SESSIONS=512
MCP_HTTP_SESSION_IDLE_SECONDS=1800
MCP_HTTP_UNUSED_SESSION_IDLE_SECONDS=300

# Logging Configuration (optional)
LOG_LEVEL=info
# LOG_LEVEL=debug  # Use for detailed debugging
# LOG_LEVEL=warn   # Use for production
# LOG_LEVEL=error  # Use for minimal logging

# Credentials Storage (optional)
# CREDENTIALS_DIR=~/.altegio-mcp

# Rate Limiting (optional)
# Number of requests allowed per time window
RATE_LIMIT_REQUESTS=200
# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Retry Configuration (optional)
# Additional read attempts; writes, timeouts and cancellations are never retried.
MAX_RETRY_ATTEMPTS=1
# Initial delay before first retry in milliseconds
INITIAL_RETRY_DELAY_MS=150
# Maximum delay between retries in milliseconds
MAX_RETRY_DELAY_MS=5000

# HTTP deployment (trusted proxy required for remote access)
# PORT=3000
# MCP_PUBLIC_BASE_URL=http://localhost:3000/mcp
# REQUIRE_DELEGATED_IDENTITY=true
# ALTEGIO_EXPOSE_PASSWORD_LOGIN=false
# What /mcp lists: compact (most used tools + dispatcher) or full (every tool, flat)
# MCP_DEFAULT_VIEW=compact

# ERP report source used by temporary analytics adapters
# ALTEGIO_LEGACY_WEB_BASE=https://app.alteg.io

# Optional runtime documentation directory
# ALTEGIO_DOCS_DIR=/absolute/path/to/docs
